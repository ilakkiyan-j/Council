# Council V2 Server Configuration
PORT=4100
NODE_ENV=development

# PostgreSQL Connection String (schema=council for tenant isolation)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&schema=council"

# Authentication & Security Secrets
# JWT Secret matching Nox for Single Sign-On
JWT_SECRET=""
# 32-Byte Master Key (hex or passphrase) for AES-256-GCM BYOK Credential Encryption
ENCRYPTION_KEY=""

# Connected Applications
NOX_API_URL="http://localhost:4000"
XION_API_URL="http://localhost:5000"
